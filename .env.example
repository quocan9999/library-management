# Server
SERVER_PORT=8081

# MySQL
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=
# Database riêng của repo gốc. Trong mỗi worktree, tự đổi thành database riêng.
MYSQL_DATABASE=library_management
MYSQL_USER=
MYSQL_PASSWORD=

# JWT
JWT_SECRET_BASE64=

# Gmail SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=

# Frontend
FRONTEND_BASE_URL=http://localhost:5173

# Chỉ cho phép seed tài khoản SUPER_ADMIN training ở môi trường local.
spring.liquibase.contexts=local

# MySQL cô lập cho integration tests (docker compose --profile test up -d --wait mysql-test)
# Repo gốc dùng library_management_test; mỗi worktree tự đặt tên riêng với hậu tố _test.
MYSQL_TEST_DATABASE=library_management_test
MYSQL_TEST_HOST=localhost
MYSQL_TEST_PORT=3308
MYSQL_TEST_ROOT_PASSWORD=
MYSQL_TEST_USER=library_test_user
MYSQL_TEST_PASSWORD=

# Cloudinary - lấy thông tin trong Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BOOK_COVER_FOLDER=library_management/book_cover

# phpMyAdmin
PMA_PORT=7070
